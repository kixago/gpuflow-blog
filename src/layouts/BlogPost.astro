---
import { Image, getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { useTranslations, type UiKey } from '../i18n/utils';
import { getTextDirection, htmlLang, appUrl, docsUrl, type LanguageCode } from '../i18n/locales';
import { publishedPosts, translationsOf, slugOf, postPath, newestFirst, jsonLd, type Post } from '../lib/posts';
import {
  organizationSchema,
  webSiteSchema,
  createWebPageSchema,
  createBreadcrumbSchema,
  createArticleSchema,
  createFAQSchema,
  createSchemaGraph,
  createBlogBreadcrumbs,
} from '../schemas/reference';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, author, category, faq } = post.data;
const lang = post.data.locale as LanguageCode;
const t = useTranslations(lang);
const canonicalURL = new URL(postPath(post), Astro.site).toString();

let ogImage: string | undefined;
if (heroImage) {
  const img = await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpg' });
  ogImage = new URL(img.src, Astro.site).toString();
}

const all = await publishedPosts();
const alternates = translationsOf(all, slugOf(post), Astro.site!);
const more = all.filter((p) => p.data.locale === lang && p.id !== post.id).sort(newestFirst);

const schemas: object[] = [
  organizationSchema,
  webSiteSchema,
  createWebPageSchema({ url: canonicalURL, title, description, datePublished: pubDate, dateModified: updatedDate, locale: lang }),
  createBreadcrumbSchema(canonicalURL, createBlogBreadcrumbs(title, canonicalURL, lang, { home: 'GPUFlow', blog: t('nav.blog') })),
  createArticleSchema({
    url: canonicalURL,
    title,
    description,
    image: ogImage ?? new URL('/og-default.jpg', Astro.site).toString(),
    datePublished: pubDate,
    dateModified: updatedDate,
    locale: lang,
    authorName: author,
  }),
];
if (faq) schemas.push(createFAQSchema(canonicalURL, faq));
---

<!doctype html>
<html lang={htmlLang(lang)} dir={getTextDirection(lang)}>
  <head>
    <BaseHead title={title} description={description} lang={lang} ogType="article" ogImage={ogImage} alternates={alternates}>
      {ogImage && <meta property="og:image:width" content="1200" />}
      {ogImage && <meta property="og:image:height" content="630" />}
      <meta property="article:published_time" content={pubDate.toISOString()} />
      {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
      <script type="application/ld+json" set:html={jsonLd(createSchemaGraph(schemas))} />
    </BaseHead>
  </head>
  <body>
    <div class="reading-progress" id="reading-progress"></div>
    <Header lang={lang} alternates={alternates} />
    <main>
      <article>
        {heroImage && (
          <div class="article-hero">
            <Image src={heroImage} alt={heroImageAlt || title} width={1200} height={500} quality={85} loading="eager" fetchpriority="high" />
          </div>
        )}

        <div class="article-header">
          <div class="article-meta">
            <span class="article-category">{t(`cat.${category}` as UiKey)}</span>
            <span class="article-date"><FormattedDate date={pubDate} lang={lang} /></span>
            {updatedDate && updatedDate.valueOf() !== pubDate.valueOf() && (
              <span class="article-date">{t('post.updated')} <FormattedDate date={updatedDate} lang={lang} /></span>
            )}
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>
        </div>

        <div class="article-content">
          <slot />
        </div>

        {faq && faq.length > 0 && (
          <div class="faq-section">
            <h2>{t('post.faq')}</h2>
            {faq.map((item) => (
              <div class="faq-item">
                <h3 class="faq-question">{item.question}</h3>
                <p class="faq-answer">{item.answer}</p>
              </div>
            ))}
          </div>
        )}
      </article>

      <aside class="container post-footer">
        <div class="cta-box">
          <h2>{t('post.ctaTitle')}</h2>
          <p>{t('post.ctaText')}</p>
          <div class="cta-actions">
            <a class="cta-primary" href={appUrl(lang, '/marketplace')}>{t('post.ctaRent')}</a>
            <a class="cta-secondary" href={docsUrl(lang)}>{t('post.ctaDocs')}</a>
          </div>
        </div>

        {more.length > 0 && (
          <section>
            <h2 class="section-title">{t('post.more')}</h2>
            <ul class="more-list">
              {more.map((p) => (
                <li>
                  <a href={postPath(p)}>{p.data.title}</a>
                  <span class="more-meta">{t(`cat.${p.data.category}` as UiKey)} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </main>
    <Footer lang={lang} />
    <script>
      const bar = document.getElementById('reading-progress');
      const article = document.querySelector('article');
      function update() {
        if (!bar || !article) return;
        const span = article.offsetHeight - window.innerHeight;
        const done = span > 0 ? (window.scrollY - article.offsetTop) / span : 1;
        bar.style.width = `${Math.min(100, Math.max(0, done * 100))}%`;
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    </script>
  </body>
</html>
