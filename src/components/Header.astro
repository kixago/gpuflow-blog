---
import { languages, appUrl, docsUrl, type LanguageCode } from '../i18n/locales';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: LanguageCode;
  // Language code -> URL of this page in that language. Languages that are
  // missing fall back to their blog home page.
  alternates?: Partial<Record<LanguageCode, string>>;
}

const { lang, alternates = {} } = Astro.props;
const t = useTranslations(lang);
const home = `/${lang}/`;
---

<header class="header">
  <div class="container">
    <div class="header-inner">
      <a href={home} class="logo">
        GPU<span>Flow</span>
      </a>

      <nav class="nav">
        <a href={home} class="nav-link">{t('nav.blog')}</a>
        <a href={docsUrl(lang)} class="nav-link">{t('nav.docs')}</a>
        <a href={appUrl(lang, '/marketplace')} class="nav-link">{t('nav.rent')}</a>
      </nav>

      <div class="lang-wrapper">
        <select class="lang-select" id="lang-select" aria-label={t('lang.label')}>
          {Object.entries(languages).map(([code, name]) => (
            <option value={alternates[code as LanguageCode] ?? `/${code}/`} selected={code === lang}>
              {name}
            </option>
          ))}
        </select>
      </div>
    </div>
  </div>
</header>

<script>
  const select = document.getElementById('lang-select') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    window.location.href = select.value;
  });
</script>
