---
import { htmlLang, type LanguageCode } from '../i18n/locales';

interface Props {
	date: Date;
	lang: LanguageCode;
}

const { date, lang } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(htmlLang(lang), { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
</time>
