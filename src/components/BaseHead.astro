---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { htmlLang, ogLocale, type LanguageCode } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  lang: LanguageCode;
  ogType?: 'website' | 'article';
  ogImage?: string;
  // Language code -> absolute URL of this page in that language.
  alternates?: Partial<Record<LanguageCode, string>>;
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  ogType = 'website',
  ogImage = new URL('/og-default.jpg', Astro.site).toString(),
  alternates = {},
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const alternateList = Object.entries(alternates) as [LanguageCode, string][];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL(`/${lang}/rss.xml`, Astro.site)} />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

{!noindex && alternateList.length > 1 && alternateList.map(([code, url]) => (
  <link rel="alternate" hreflang={htmlLang(code)} href={url} />
))}
{!noindex && alternateList.length > 1 && alternates.en && (
  <link rel="alternate" hreflang="x-default" href={alternates.en} />
)}

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale(lang)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<slot />

<script src="https://anal.gpuflow.app/api/script.js" data-site-id="45ee90ef902f" defer></script>
