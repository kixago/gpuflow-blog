---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { languages, getTextDirection, htmlLang, type LanguageCode } from '../../i18n/locales';
import { useTranslations, type UiKey } from '../../i18n/utils';
import { publishedPosts, postPath, newestFirst } from '../../lib/posts';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LanguageCode;
const t = useTranslations(lang);

const posts = (await publishedPosts()).filter((p) => p.data.locale === lang).sort(newestFirst);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);

const alternates = Object.fromEntries(
  Object.keys(languages).map((code) => [code, new URL(`/${code}/`, Astro.site).toString()]),
);

const excerpt = (text: string, max: number) => (text.length > max ? `${text.slice(0, max).trimEnd()}…` : text);
---

<!doctype html>
<html lang={htmlLang(lang)} dir={getTextDirection(lang)}>
  <head>
    <BaseHead title={`${SITE_TITLE}: ${t('home.title')}`} description={t('site.description')} lang={lang} alternates={alternates} />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <section class="hero">
      <div class="container">
        <h1>{t('home.title')}</h1>
        <p>{t('home.subtitle')}</p>
      </div>
    </section>

    <main class="container">
      {posts.length === 0 ? (
        <div class="empty">
          <h2>{t('home.empty')}</h2>
        </div>
      ) : (
        <>
          <section>
            <div class="section-label">{t('home.featured')}</div>
            <a href={postPath(featured)} class="featured-card">
              {featured.data.heroImage ? (
                <Image src={featured.data.heroImage} alt={featured.data.heroImageAlt || featured.data.title} class="featured-img" width={600} height={412} loading="eager" />
              ) : (
                <div class="featured-img-placeholder" />
              )}
              <div class="featured-body">
                <div class="featured-cat">{t(`cat.${featured.data.category}` as UiKey)}</div>
                <h2 class="featured-title">{featured.data.title}</h2>
                <p class="featured-excerpt">{excerpt(featured.data.excerpt ?? featured.data.description, 180)}</p>
                <div class="featured-meta">
                  <FormattedDate date={featured.data.pubDate} lang={lang} />
                </div>
              </div>
            </a>
          </section>

          {rest.length > 0 && (
            <section>
              <h2 class="section-title">{t('home.allPosts')}</h2>
              <div class="posts-grid">
                {rest.map((post) => (
                  <a href={postPath(post)} class="post-card">
                    {post.data.heroImage ? (
                      <Image src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} class="post-img" width={400} height={225} loading="lazy" />
                    ) : (
                      <div class="post-img-placeholder" />
                    )}
                    <div class="post-body">
                      <div class="post-cat">{t(`cat.${post.data.category}` as UiKey)}</div>
                      <h3 class="post-title">{post.data.title}</h3>
                      <p class="post-excerpt">{excerpt(post.data.excerpt ?? post.data.description, 110)}</p>
                      <div class="post-meta">
                        <FormattedDate date={post.data.pubDate} lang={lang} />
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}
        </>
      )}
    </main>

    <Footer lang={lang} />
  </body>
</html>
